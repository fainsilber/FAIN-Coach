node_modules
dist
dist-ssr
dev-dist
*.local
*.tsbuildinfo

# Dexie Cloud CLI output (docs/dexie-cloud-setup.md). Environment, not source.
# dexie-cloud.key contains a CLIENT SECRET granting access to the database —
# it must never be committed.
dexie-cloud.json
dexie-cloud.key

# Local env files that may hold VITE_DEXIE_CLOUD_URL and similar
.env
.env.*
!.env.example

# Editor
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store

# Worker config: created locally from wrangler.example.jsonc once a KV
# namespace exists (docs/garmin-worker-setup.md). Not committed while the
# Cloudflare deploy is still assets-only — a config naming a missing KV
# namespace would fail every deploy.
wrangler.jsonc
.wrangler/
